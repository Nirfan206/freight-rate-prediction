# Copy to .env for local use (docker compose reads it automatically). Never commit .env.
# This project needs NO credentials: there are no API keys, passwords or tokens to set.

# Where model versions + production.json live
MODEL_REGISTRY_PATH=models/registry
# Optional: force a specific registry version, overriding production.json (e.g. v1). Leave empty normally.
PRODUCTION_MODEL_VERSION=

# Prediction log / drift / performance / retraining status
MONITORING_PATH=monitoring
# Where data/train-test.csv lives (used by training scripts)
DATA_DIR=data

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Used by uvicorn when you run it yourself / by docker-compose
API_HOST=0.0.0.0
API_PORT=8000

# Append every prediction to monitoring/predictions/predictions.jsonl
PREDICTION_LOGGING=true
# Include the freight features (distance, coordinates, equipment, ...) in those records (needed for drift on live traffic)
LOG_INPUT_FEATURES=true
